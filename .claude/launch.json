{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--host",
        "0.0.0.0",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "design",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "http-server@14.1.1",
        "design",
        "-p",
        "5180",
        "-c-1",
        "--silent"
      ],
      "port": 5180
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "web",
        "wrangler",
        "dev",
        "-c",
        "web/wrangler.jsonc",
        "--port",
        "8787"
      ],
      "port": 8787
    }
  ]
}