// Cloudflare Workers static-assets deploy for the GiftHub web app.
// Committed so Workers Builds doesn't auto-generate a config on every build.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gifthub",
  "compatibility_date": "2026-11-16",
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist",
    // Unknown paths (e.g. /circles opened directly) serve index.html so the client router can handle them.
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": true
}
