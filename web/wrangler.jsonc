// Cloudflare Workers static-assets deploy for the GiftHub web app.
// Committed so Workers Builds doesn't auto-generate a config on every build.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gifthub",
  // Only /api/* runs this script; every other path is a static file or the app shell.
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-16",
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Unknown paths (e.g. /circles opened directly) serve index.html so the client router can handle them.
    "not_found_handling": "single-page-application"
  },
  // Public values (the project address is in the app bundle too). No secrets here.
  "vars": { "SUPABASE_URL": "https://nglsxidmpjblwntugodo.supabase.co" },
  // Link reading: 30 a minute per person.
  "ratelimits": [{ "name": "PARSE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "workers_dev": true,
  "preview_urls": true
}
