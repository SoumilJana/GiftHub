# Supabase -> Project Settings -> API Keys. The publishable key is safe in browser code.
# Never put the secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Cloudflare Turnstile site key (public). GiftHub's own key is built into src/lib/turnstile.ts; set this only to override it.
# Local testing: 1x00000000000000000000AA always passes.
VITE_TURNSTILE_SITE_KEY=
